   "text": "def c1_attr_ret(a):\n    return f(a).x\n\n\ndef c2_neg_ret(a):\n    return -f(a)\n\n\ndef c3_throw_wrapped(a):\n    raise g(a).err\n\n\ndef c4_bound(a):\n    x = f(a)\n    return x\n\n\ndef c5_twice(a):\n    f(a)\n    f(a)\n\n\ndef c6_loop(a):\n    for i in a:\n        h(i)\n\n\ndef c7_merge(a):\n    f(a)\n    return f(a)\n\n\ndef c8_nested(a):\n    h(g(a))\n\n\ndef c9_ret(a):\n    return f(a)\n"
  },
  "typescript": {
   "path": "p0_controls.ts",
   "text": "export function c1AttrRet(a: any) { return f(a).x; }\nexport function c2NegRet(a: number) { return -f(a); }\nexport function c3ThrowWrapped(a: any) { throw g(a).err; }\nexport function c9Ret(a: number) { return f(a); }\n"
  }
